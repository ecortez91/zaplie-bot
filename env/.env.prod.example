# Template for env/.env.prod — copy to env/.env.prod and fill in locally.
# env/.env.prod is gitignored: do NOT commit real values. Unlike local and dev,
# scripts/writeEnv.js does not fall back to env/.env.dev for this environment,
# so every value the bot needs must be set here (or in the process
# environment). AAD_APP_CLIENT_SECRET and BOT_PASSWORD go to
# env/.env.prod.user as SECRET_* values, written by `teamsapp provision`.
#
#   teamsapp provision --env prod
#   teamsapp deploy --env prod
#   teamsapp publish --env prod   # then approve in Teams Admin Center

# Built-in environment variables
TEAMSFX_ENV=prod
APP_NAME_SUFFIX=prod
# Must differ from dev so prod gets its own App Service and bot (4-20 chars
# including the "bot" prefix).
RESOURCE_SUFFIX=prod
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=

# Populated during `teamsapp provision`
BOT_ID=
BOT_DOMAIN=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=
AAD_APP_OAUTH_AUTHORITY_HOST=
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
AAD_APP_ACCESS_AS_USER_PERMISSION_ID=

# Production LNbits instance. Use freshly rotated credentials: values that
# ever reached a portal bundle are compromised (docs/DEPLOYMENT.adoc, Day One).
LNBITS_NODE_URL=
LNBITS_USERNAME=
LNBITS_PASSWORD=
LNBITS_ADMINKEY=
LNBITS_INITIAL_ALLOWANCE=15000
LNBITS_POINTS_LABEL="Sats"
# Required outside development mode: the App Service persistent share.
ZAPLIE_DATA_DIR=%HOME%\data\zaplie

# Rewards API
# Same value as the portal App Service; generate with `openssl rand -hex 32`
TAB_BACKEND_TOKEN=
# https://<portal-domain>/api
WEBSITE_API_URL=
REWARDS_API_KEY=
REWARDS_TREASURY_ADMINKEY=
REWARDS_MAX_AMOUNT_SATS=10000
# ZAP_MAX_AMOUNT_SATS=

# Azure AI Foundry and delegated Microsoft Graph tools
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
GRAPH_CONNECTION_NAME=GraphWorkSignals

# Bot Manifest file variables
APP_VERSION=
# The production portal URL (zaplie-prod-webapp or its custom domain)
CONTENT_URL=
WEBSITE_URL=
PORTAL_URL=
